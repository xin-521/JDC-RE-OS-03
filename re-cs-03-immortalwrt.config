# ImmortalWrt openwrt-25.12 -- immortalwrt/immortalwrt @ openwrt-25.12
# Device: JDCloud RE-CS-03 (IPQ5018 + QCN6122, eMMC)
#
# Deliberately a separate seed from re-cs-03.config/re-cs-03-fanchmwrt.config:
# ImmortalWrt's tree and feeds differ (kernel 6.12.116, no 0751 qca8k patch,
# its own luci/packages feeds with luci-theme-argon but without luci-compat or
# passwall2). Only symbols that exist in THIS tree/feed set are named below;
# kconfig drops an unknown symbol silently, so the workflow re-asserts every
# CONFIG_PACKAGE_*=y line after `make defconfig`.

CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq50xx=y
CONFIG_TARGET_qualcommax_ipq50xx_DEVICE_jdcloud_re-cs-03=y
CONFIG_TARGET_OPTIMIZATION="-O2 -pipe -mcpu=cortex-a53+crc+crypto"
CONFIG_TARGET_OPTIONS=y

# --- eMMC ---------------------------------------------------------------
# /dev/mmcblk0p16 (rootfs_data) is ~960MB, above fstools' F2FS_MINSIZE
# (100MB), so the first boot runs mkfs.f2fs for the overlay. f2fs-tools is
# the metapackage that pulls mkf2fs + f2fsck; e2fsprogs is kept for the
# ext4 path used by block-mount/disk images.
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_e2fsprogs=y

# --- device -------------------------------------------------------------
# The device's DEVICE_PACKAGES already name the wifi blobs; kept explicit so
# an upstream rename fails the build instead of shipping a firmware-less radio.
CONFIG_PACKAGE_ath11k-firmware-ipq5018-qcn6122=y
CONFIG_PACKAGE_ipq-wifi-jdcloud_re-cs-03=y
CONFIG_PACKAGE_uboot-envtools=y

# --- wireguard ----------------------------------------------------------
# kmod-wireguard lives in package/kernel/linux/modules/netsupport.mk and
# pulls kmod-crypto-lib-chacha20poly1305/-curve25519 + kmod-udptunnel4/6 by
# itself. wireguard-tools is the in-tree userspace package (wg + the netifd
# proto handler); luci-proto-wireguard is the LuCI editor and only needs
# wireguard-tools/ucode/luci-lib-uqr/resolveip, all present in this feed set.
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# --- field diagnostics --------------------------------------------------
# Both live in this tree (package/network/utils), not in a feed, so they
# cannot disappear behind a feed bump. Drop this block to save ~600 KiB.
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_tcpdump=y

# --- wireless daemon ----------------------------------------------------
# qualcommax's DEFAULT_PACKAGES selects wpad-openssl here, but pin the pair:
# files/etc/uci-defaults/999-QOL_config sets 802.11v/proxy_arp, which only the
# full variants compile in (CONFIG_WNM/CONFIG_PROXYARP). All wpad variants
# CONFLICT with each other, so =y and =n must stay together.
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_wpad-basic-mbedtls=n

# --- theme --------------------------------------------------------------
# ImmortalWrt's own luci feed carries luci-theme-argon (3.1.x); since 3.0.0 it
# sets LUCI_BASENAME:=argon-config and ships the config app itself, so the
# standalone luci-app-argon-config must NOT be added on top.
CONFIG_PACKAGE_luci-theme-argon=y
