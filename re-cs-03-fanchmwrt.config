# FanchmWrt official stable -- fanchmwrt/fanchmwrt @ fanchmwrt-25.12.4
# Device: JDCloud RE-CS-03 (IPQ5018 + QCN6122, eMMC)
#
# Deliberately a separate seed from re-cs-03.config. That one is written for the
# qosmio NSS tree and asks for kmod-qca-nss-drv/-ecm/-igs/-qdisc, CONFIG_FEED_nss,
# ATH11K_NSS_SUPPORT and MAC80211_NSS_SUPPORT -- nothing of which exists in this
# tree -- and kconfig drops an unknown symbol *silently*, so reusing it would
# hide a wrong name until the image is already on the device. This file names
# only things that really exist here (in-tree or in this tree's feeds), and the
# workflow re-asserts every CONFIG_PACKAGE_*=y below after `make defconfig`.
#
# Not built on purpose: OpenClash, PassWall2, Docker, luci-app-accesscontrol.

CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq50xx=y
CONFIG_TARGET_qualcommax_ipq50xx_DEVICE_jdcloud_re-cs-03=y
CONFIG_TARGET_OPTIMIZATION="-O2 -pipe -mcpu=cortex-a53+crc+crypto"
CONFIG_TARGET_OPTIONS=y

# --- eMMC ---------------------------------------------------------------
# /dev/mmcblk0p16 (rootfs_data) is ~960MB, and fstools hands anything above
# F2FS_MINSIZE (100MB) to mkfs.f2fs, so without these the overlay never comes
# up on first boot. f2fs-tools is the metapackage: it pulls mkf2fs + f2fsck.
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_f2fs-tools=y

# --- device -------------------------------------------------------------
# ath11k-firmware-ipq5018-qcn6122 and ipq-wifi-jdcloud_re-cs-03 are already
# named by the device's DEVICE_PACKAGES; kept explicit so a rename upstream
# shows up here as a build failure instead of a silently firmware-less radio.
CONFIG_PACKAGE_ath11k-firmware-ipq5018-qcn6122=y
CONFIG_PACKAGE_ipq-wifi-jdcloud_re-cs-03=y
CONFIG_PACKAGE_uboot-envtools=y

# --- rootfs tooling -----------------------------------------------------
CONFIG_PACKAGE_e2fsprogs=y