uci -q batch << EOI

# Wireless default settings for radio0 (IPQ5018 internal radio = 2.4 GHz)
set wireless.default_radio0.wnm_sleep_mode='1'
set wireless.default_radio0.ieee80211k='1'
set wireless.default_radio0.time_advertisement='2'
set wireless.default_radio0.bss_transition='1'
set wireless.default_radio0.proxy_arp='1'
# ocv is deliberately NOT set. hostapd rejects the whole BSS with
#   "OCV: PMF needs to be enabled whenever using OCV"
#   "1 errors found in configuration file" -> hostapd.add_iface failed
# unless ieee80211w (PMF) is enabled as well, and PMF buys nothing on a plain
# home AP. If OCV is ever wanted, set ieee80211w='1' in the same block.

# Wireless radio0 specific settings: 2.4 GHz tops out at HE40 (574 Mbps)
set wireless.radio0.htmode='HE40'
set wireless.radio0.channel='auto'
set wireless.radio0.country='DE'

# Wireless default settings for radio1 (QCN6122 = 5 GHz)
set wireless.default_radio1.wnm_sleep_mode='1'
set wireless.default_radio1.ieee80211k='1'
set wireless.default_radio1.time_advertisement='2'
set wireless.default_radio1.bss_transition='1'
set wireless.default_radio1.proxy_arp='1'

# Wireless radio1 specific settings: 5 GHz, 2x2 HE160 = 2402 Mbps (AX3000).
# With channel='auto' + country='DE' the ACS may pick a DFS channel, and then
# hostapd has to run a 60 s CAC before the AP shows up; pin channel='36' to
# skip that if the delay bothers you.
set wireless.radio1.htmode='HE160'
set wireless.radio1.channel='auto'
set wireless.radio1.country='DE'

# Firewall settings
set firewall.@zone[1].input='DROP'
set firewall.@zone[1].forward='DROP'
# zone[0] is the LAN zone: it must stay open, or the box is unreachable from
# the LAN ports at 192.168.1.1 even though dnsmasq answered the DHCP request.
set firewall.@zone[0].input='ACCEPT'
set firewall.@zone[0].output='ACCEPT'
set firewall.@zone[0].forward='ACCEPT'

# LAN must serve DHCP and answer on 192.168.1.1 out of the box.  Without this a
# downstream device behind lan1-3 comes up with 169.254.x.x and never reaches
# the management page.
set network.lan.proto='static'
set network.lan.ipaddr='192.168.1.1'
set network.lan.netmask='255.255.255.0'
set dhcp.lan.interface='lan'
set dhcp.lan.ignore='0'
set dhcp.lan.dhcpv4='server'
set dhcp.lan.start='100'
set dhcp.lan.limit='150'
set dhcp.lan.leasetime='12h'

# Network settings
set network.globals.packet_steering='0'
set network.@device[0].flow_offloading='0'
set network.@device[0].flow_offloading_hw='0'

# uHTTPd settings
set uhttpd.main.redirect_https='1'

# BanIP settings
add_list banip.global.ban_feed='doh'

# Enable IPv6
set network.lan.ipv6='1'
set network.wan.ipv6='1'
set network.@device[0].ipv6='1'
set network.lan.delegate='1'
set network.wan.delegate='1'
set network.wan6=interface
set network.wan6.device='@wan'
set network.wan6.proto='dhcpv6'
set dhcp.lan.dhcpv6='server'
set dhcp.lan.ra='server'
set dhcp.lan.ra_slaac='1'
set dhcp.lan.ra_default='1'
EOI
